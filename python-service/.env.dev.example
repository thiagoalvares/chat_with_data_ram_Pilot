# DEV environment — copy to .env on the dev box:  cp .env.dev.example .env

# LLM gateway (GA internal)
LITELLM_API_KEY=your_dev_key_here
LITELLM_API_BASE=https://aigateway.ga.com
LLM_MODEL=claude-sonnet-4-5

SERVICE_PORT=8000

# Storage: disk is fine for a single dev instance (restart-safe, no SQL Server needed).
STORAGE_BACKEND=disk
STATE_DIR=local_state
DATA_DIR=local_state/fileshare

LOG_LEVEL=INFO
