# PROD environment — copy to .env on each PROD instance:  cp .env.prod.example .env
# Prefer pulling secrets from your secret store rather than committing them.

# LLM gateway (GA internal)
LITELLM_API_KEY=__from_secret_store__
LITELLM_API_BASE=https://aigateway.ga.com
LLM_MODEL=claude-sonnet-4-5

SERVICE_PORT=8000

# Storage: SQL Server (shared) + network file share — required for multiple
# stateless instances behind the load balancer.
STORAGE_BACKEND=sqlserver
SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:SQLHOST-PROD,1433;Database=ChatWithData;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=no;
SQL_SESSIONS_TABLE=dbo.sessions
# UNC path to the PROD file share for uploaded data (Parquet):
DATA_DIR=\\\\fileserver\\chatwithdata\\prod

LOG_LEVEL=WARNING
