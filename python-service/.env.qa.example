# QA environment — copy to .env on each QA instance:  cp .env.qa.example .env

# LLM gateway (GA internal)
LITELLM_API_KEY=your_qa_key_here
LITELLM_API_BASE=https://aigateway.ga.com
LLM_MODEL=claude-sonnet-4-5

SERVICE_PORT=8000

# Storage: SQL Server (shared) + network file share — required for multiple
# stateless instances behind the load balancer.
STORAGE_BACKEND=sqlserver
SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:SQLHOST-QA,1433;Database=ChatWithData_QA;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=no;
SQL_SESSIONS_TABLE=dbo.sessions
# UNC path to the QA file share for uploaded data (Parquet):
DATA_DIR=\\\\fileserver\\chatwithdata\\qa

LOG_LEVEL=INFO
