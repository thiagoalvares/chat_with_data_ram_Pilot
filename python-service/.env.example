# Copy to .env and fill in values:  cp .env.example .env

# ── Required for live answers (internal GA network / VPN) ─────────────────────
LITELLM_API_KEY=your_key_here
LITELLM_API_BASE=https://aigateway.ga.com

# ── Optional — defaults shown ─────────────────────────────────────────────────
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1024

SERVICE_PORT=8000
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-random-string

MAX_FILE_SIZE_MB=50
SESSION_TIMEOUT_MINUTES=120

# ── Session storage backend ───────────────────────────────────────────────────
# memory  (default) — in-process; simplest; lost on restart.
# disk              — SQLite + Parquet on local disk; restart-safe; mirrors the
#                     production pattern (SQL Server + network file share).
STORAGE_BACKEND=memory
# Where the disk backend keeps state (local stand-ins for prod infra):
STATE_DIR=local_state
DATA_DIR=local_state/fileshare

LOG_DIR=logs
LOG_LEVEL=INFO

# ── Per-user API keys & usage tracking (rollout batch) ────────────────────────
# Encrypts users' stored API keys. Generate ONCE and keep safe:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Comma-separated admin usernames (with or without DOMAIN\ prefix)
ADMIN_USERS=thiago.alvares

# Optional shared secret between .NET and Python. When set, Python rejects any
# request without a matching X-Internal-Auth header (set the same value in the
# .NET appsettings under PythonService:InternalSecret). Recommended while the
# Python service runs on a separate machine from .NET.
INTERNAL_API_SECRET=

# Optional: override the SQLite path (defaults to python-service/chatdata.db)
DB_PATH=
